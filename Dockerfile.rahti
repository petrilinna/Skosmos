FROM quay.io/natlibfi/skosmos:latest

USER root

RUN sed -i 's/Listen 80/Listen 8080/g' /etc/apache2/ports.conf || true && \
    find /etc/apache2 -type f -name "*.conf" -exec sed -i 's/:80/:8080/g' {} \; || true && \
    sed -i 's|/var/log/apache2/.*access.log|/proc/self/fd/1|g' /etc/apache2/sites-enabled/*.conf || true && \
    sed -i 's|/var/log/apache2/.*error.log|/proc/self/fd/2|g' /etc/apache2/sites-enabled/*.conf || true && \
    sed -i 's|/var/log/apache2/other_vhosts_access.log|/proc/self/fd/1|g' /etc/apache2/conf-enabled/other-vhosts-access-log.conf || true && \
    chmod -R g=u /var/log/apache2 /var/run/apache2 /var/lock/apache2 /var/www/html || true

EXPOSE 8080FROM quay.io/natlibfi/skosmos:latest

USER root

RUN sed -i 's/Listen 80/Listen 8080/g' /etc/apache2/ports.conf || true && \
    find /etc/apache2 -type f -name "*.conf" -exec sed -i 's/:80/:8080/g' {} \; || true

EXPOSE 8080
