FROM quay.io/natlibfi/skosmos:latest

USER root

RUN sed -i 's/^Listen 80$/Listen 8080/' /etc/apache2/ports.conf && \
    sed -i 's/<VirtualHost \*:80>/<VirtualHost *:8080>/' /etc/apache2/sites-available/000-default.conf && \
    sed -i 's#${APACHE_LOG_DIR}/access.log#/proc/self/fd/1#g' /etc/apache2/sites-available/000-default.conf && \
    sed -i 's#${APACHE_LOG_DIR}/error.log#/proc/self/fd/2#g' /etc/apache2/sites-available/000-default.conf && \
    sed -i 's#/var/log/apache2/other_vhosts_access.log#/proc/self/fd/1#g' /etc/apache2/conf-available/other-vhosts-access-log.conf && \
    chmod -R g=u /var/log/apache2 /var/run/apache2 /var/lock/apache2 /var/www/html

EXPOSE 8080
